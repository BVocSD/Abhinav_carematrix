# Firebase (client – used in browser)
# Get these from Firebase Console → Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase Admin (backend only – for API routes / Server Actions)
# From Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the values from the downloaded JSON (keep private key secret).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: use a path to a service account JSON file instead of the vars above (e.g. on GCP)
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json

# Google AI (Gemini) – used by the CareMatrix Assistant chatbot
# Get an API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
